# ===== Database (local) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=wwmai

# ===== Database (production, Neon) — takes precedence over DB_* =====
# DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ===== Auth =====
# REQUIRED in production — the app refuses to start without it there
JWT_SECRET=change_me_to_a_long_random_string

# ===== AI question generation (optional) =====
GEMINI_API_KEY=your_api_key_here

# ===== Admin dashboard (optional; default 'admin' in dev only) =====
ADMIN_PASSWORD=change_me

# ===== Stripe (optional, needed for premium) =====
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
